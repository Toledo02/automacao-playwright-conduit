        "password": "SenhaInvalida#2026"
      },
      "expected": {
        "errorContains": "email or password is invalid"
      }
    },
    {
      "id": "AUTH_LOGIN_INVALID_02",
      "ctId": "CT003",
      "strategy": "fixed",
      "description": "Login com email inexistente",
      "payload": {
        "email": "nao.existe.{{dateYMD}}@example.com",
        "password": "Qualquer#123"
      },
      "expected": {
        "errorContains": "email or password is invalid"
      }
    }
  ]
