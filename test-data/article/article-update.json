{
  "meta": {
    "id": "ARTICLE_UPDATE_V1",
    "domain": "article",
    "version": "1.0.0",
    "lastUpdated": "2026-04-25",
    "owner": "qa-automation"
  },
  "scenarios": [
    {
      "id": "ARTICLE_EDIT_01",
      "ctId": "CT010",
      "strategy": "hybrid",
      "description": "Editar artigo criado no fluxo",
      "payload": {
        "targetArticleSlug": "{{createdArticleSlug}}",
        "newTitle": "Portfolio Playwright Article Edited {{runId}}",
        "newBody": "Corpo atualizado em execucao automatizada {{ts}}"
      },
      "expected": {
        "titleShouldChange": true,
        "bodyShouldContain": "atualizado"
      }
    },
    {
      "id": "ARTICLE_DELETE_01",
      "ctId": "CT011",
      "strategy": "hybrid",
      "description": "Excluir artigo criado no fluxo",
      "payload": {
        "targetArticleSlug": "{{createdArticleSlug}}",
        "confirmDelete": true
      },
      "expected": {
        "articleShouldNotBeVisibleInMyArticles": true
      }
    }
  ]
}
